<Project Sdk="Dalamud.NET.Sdk/15.0.0">
    <PropertyGroup>
        <OutputPath>dist</OutputPath>
        <Platforms>x64</Platforms>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Authors>RichardLH</Authors>
        <Version>1.4.14.0</Version>
        <AssemblyVersion>1.4.14.0</AssemblyVersion>
        <FileVersion>1.4.14.0</FileVersion>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <DefineConstants>DEBUG;TRACE</DefineConstants>
    </PropertyGroup>

    <!-- TinyIpc: cross-process broadcast bus (memory-mapped file + named mutex)
         used by the Party Mode coordinator so 2+ FFXIV clients on the same
         machine can exchange FATE_ASSIGN / HEARTBEAT messages. Windows-only,
         which matches FFXIV + Dalamud's target platform. Reference: MBT and the
         steamcore/TinyIpc maintained NuGet. -->
    <ItemGroup>
        <PackageReference Include="TinyIpc" Version="5.0.1" />
    </ItemGroup>
</Project>
